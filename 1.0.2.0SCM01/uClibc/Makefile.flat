# *************************************************************************
# * Makefile Wrapper file for building uClibc.
# *************************************************************************

-include $(TARGET_HOME)/TI_Build.make
-include $(TARGET_HOME)/.config
-include ./.config

all: build install

.config:
ifdef CONFIG_TI_SYSTEM_UCLIBC_DEBUG
	@sed 's/# PTHREADS_DEBUG_SUPPORT is not set/PTHREADS_DEBUG_SUPPORT=y/g' $(TARGET_HOME)/build/$(PRODUCT_NAME)/configs/TI_uClibc-0.9.29.config | sed 's/# UCLIBC_HAS_RPC is not set/UCLIBC_HAS_RPC=y\nUCLIBC_HAS_FULL_RPC=y\nUCLIBC_HAS_REENTRANT_RPC=y/g' | sed 's/DOSTRIP=y/# DOSTRIP is not set/g' > .config
else
	@install --preserve-timestamps $(TARGET_HOME)/build/$(PRODUCT_NAME)/configs/TI_uClibc-0.9.29.config .config
endif    
	$(MAKE) oldconfig

config: .config

build: config
	$(MAKE) KERNEL_HEADERS=$(TI_include) KERNEL_SOURCE=$(KERNEL_DIR) CROSS=$(CROSS_TOOLS)	CONFIG_ARM_THUMB=$(CONFIG_ARM_THUMB) all

install: build
	$(MAKE) install DEVEL_PREFIX=$(TARGET_HOME)/ti/ PREFIX= RUNTIME_PREFIX=$(TI_filesystem_path)/

uninstall:
	$(RM) -r $(TARGET_HOME)/ti/include
	$(RM) -r $(TARGET_HOME)/ti/lib
	$(RM) -r $(TARGET_HOME)/ti/bin

clean: uninstall
	$(MAKE) clean

distclean: clean
#	@$(RM) include/mtd
#	@cd include/sys; \
#	set -e; \
#	for i in `ls ../../libc/sysdeps/linux/common/sys/*.h` ; do \
#		$(RM) `basename $$i`; \
#	done
#ifdef TARGET_ARCH
#	@cd include/sys; \
#	set -e; \
#	if [ -d ../../libc/sysdeps/linux/$(TARGET_ARCH)/sys ] ; then \
#		for i in `ls ../../libc/sysdeps/linux/$(TARGET_ARCH)/sys/*.h` ; do \
#			$(RM) `basename $$i`; \
#		done; \
#	fi
#endif
	$(MAKE) distclean

.PHONY: all config build install uninstall clean distclean
