# Required definitions
ifndef TARGET_HOME
TARGET_HOME := /vobs/ua_sdk
endif

# File system path, where to install the module
ifndef TI_filesystem_path
TI_filesystem_path := $(TARGET_HOME)/build/dsdk/fs
endif

ifndef CROSS
CROSS := arm_v6_be_uclibc-
endif

CC := $(CROSS)gcc

#
# Final output target
#
TARGET := exmapserver

#
# Compilation options to add to the compiler (optional)
#
CFLAGS := -DEXMAP_VERSION=\"0.9\" -DEXMAP_PROTOCOL_VERSION=\"0.1\" -DINTERACTIVE

obj-y := exmapserver.o

all: build install

build: $(TARGET)

$(TARGET): $(obj-y)
	@rm -f $@
	@echo "  CC [TGT] 	$@"
	@$(CC) $(LDFLAGS) -o $@ $(filter $(obj-y), $^)

install:
	@install -m 0755 $(TARGET) $(TI_filesystem_path)/bin/$(notdir $(TARGET))	

clean:
	@rm -f exmap $(obj-y)

config:

uninstall:
	@rm -f $(TI_filesystem_path)/bin/$(notdir $(TARGET))

distclean: clean uninstall

%.o : %.c
	@echo "  CC [C] 	$@"
	@$(CC) $(CFLAGS) -c $< -o $@

