include ti_wpa_export.mak

#CFLAGS=-D_LIBC_REENTRANT -Wall -g -EB -mgp32 -mcpu=r4000 -mips2 -non_shared -DRW_MULTI_THREAD -D_REENTRANT -funroll-loops -fno-for-scope -DMIPSEB -msoft-float -DCPU=RC32364 
CFLAGS += -Wall -EB -G 0 -mips2 -msoft-float -pipe -DRW_MULTI_THREAD
CFLAGS += -D_REENTRANT -funroll-loops -fno-for-scope
CFLAGS += -DCPU=MIPS32 -DTOOL_FAMILY=gnu -DTOOL=sfgnu -DMIPSEB -DSOFT_FLOAT
CFLAGS += -DVXWORKS -DVLYNQ0 -DBIG_ENDIAN -D_LINK_KSEG0_ 
CFLAGS += -fno-builtin -fdollars-in-identifiers -mno-branch-likely -funsigned-char
CFLAGS+=-G 0 -ansi -nostdinc

CFLAGS+=-DNO_ASM -DNO_BF -DNO_CAST -DNO_MDC2 -DNO_MD2 -DNO_RC2 -DNO_RC5 \
  -DNO_IDEA -DTERMIO -DNO_SYS_UN_H

CFLAGS+=-DB_ENDIAN

PLATFORM=vxworks
CFLAGS+=-DVXWORKS -DCONFIG_RG_TARGET_VXWORKS -DNO_STRINGS_H -DOPENSSL_SYS_VXWORKS

BN_ASM= bn_asm.o
DES_ENC= des_enc.o fcrypt_b.o
AES_ASM_OBJ= aes_core.o aes_cbc.o
BF_ENC= bf_enc.o
CAST_ENC= c_enc.o
RC4_ENC= rc4_enc.o
RC5_ENC= rc5_enc.o 

# XXX OpenSSL's headers are not strict ANSI (do not have full prototypes).
# Therefore we must disable the strict prototype checking only for this package
#CFLAGS=$(filter-out -Wstrict-prototypes,$(CFLAGS))

INCLUDES = -I$(WIND_BASE)/target/h -I$(OPENSSL_DIR)/include/ -I$(OPENSSL_DIR)/crypto -I$(OPENSSL_DIR)/ \
  -I$(WIND_BASE)/host/x86-win32/lib/gcc-lib/mips-wrs-vxworks/2.96-mips3264-010729/include \


CFLAGS+=$(INCLUDES)

# build-configuration info
AS      = ccmips
LD      = ldmips
CC      = ccmips
CPP     = ccmips -E -P -xc
AR      = armips
NM      = nmmips -g
STRIP   =
OBJCOPY = objcopymips
OBJDUMP = objdumpmips
RANLIB  =
STRIP   =
SIZE	= sizemips
ARFLAGS = crus

CPU     = MIPS32
TOOL    = sfgnu
%.o : %.c
	$(CC) $(CFLAGS) -c $< -o $@

all: buildinf.h libcrypto.a libssl.a

buildinf.h: 
	(@echo #ifndef MK1MF_BUILD) > ../crypto/buildinf.h
	(@echo /* auto-generated by crypto/Makefile for crypto/cversion.c */) >> ../crypto/buildinf.h
	(@echo #define CFLAGS "$(CC) $(CFLAGS)") >> ../crypto/buildinf.h
	(@echo #define PLATFORM "$(PLATFORM)") >> ../crypto/buildinf.h
	(@echo #define DATE  "$(shell date /T)" )>> ../crypto/buildinf.h
	(@echo #endif ) >> ../crypto/buildinf.h


libcrypto.a: $(CRYPTO_FILES)
	$(AR) $(ARFLAGS) $@ $^

libssl.a: $(SSL_FILES)
	$(AR) $(ARFLAGS) $@ $^

clean:
	$(foreach file,$(CRYPTO_FILES),$(RM) $(file))
	$(foreach file,$(SSL_FILES),$(RM) $(file))
	$(RM) ./*.a
