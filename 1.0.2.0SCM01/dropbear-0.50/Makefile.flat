# Include this file that contains definitions.
-include $(TARGET_HOME)/TI_Build.make
-include $(TARGET_HOME)/.config

ifeq ($(CONFIG_TI_DROPBEAR_SERVER),y) 
dropbear_programs=dropbear
endif
ifeq ($(CONFIG_TI_DROPBEAR_CLIENT),y) 
dropbear_programs+= dbclient
endif
ifeq ($(CONFIG_TI_DROPBEAR_SCP),y) 
dropbear_programs+= scp
endif
ifeq ($(CONFIG_TI_DROPBEAR_KEY),y) 
dropbear_host_programs+= dropbearkey
build_host_programs = 1
endif
ifeq ($(CONFIG_TI_DROPBEAR_KEYCONVERTER),y) 
dropbear_host_programs+= dropbearconvert
build_host_programs = 1
endif

ifeq ($(build_host_programs),1)
all: build install build_host install_host
else
all: build install
endif

build:
	$(MAKE) CC=$(CROSS)gcc RANLIB=$(CROSS)ranlib AR=$(CROSS)ar strip=$(CROSS)strip SHARED=ON PROGRAMS="$(dropbear_programs)" LDFLAGS+=-L$(TI_filesystem_path)$(TI_rlibdir)

install:
	$(MAKE) CC=$(CROSS)gcc RANLIB=$(CROSS)ranlib AR=$(CROSS)ar -i prefix=$(TI_filesystem_path)$(TI_rusrdir) PROGRAMS="$(dropbear_programs)" install

build_host:
	@if [ -e ./Makefile ]; then \
	$(MAKE) CC=gcc PROGRAMS="$(dropbear_host_programs)" clean; \
	fi
	$(MAKE) CC=gcc RANLIB=ranlib AR=ar strip=strip SHARED=ON PROGRAMS="$(dropbear_host_programs)" LDFLAGS= 

install_host:
	$(MAKE) CC=gcc RANLIB=ranlib AR=ar -i prefix=$(TI_tools_path)$(TI_rusrdir) PROGRAMS="$(dropbear_host_programs)" install

clean:
	@if [ -e ./Makefile ]; then \
	$(MAKE) CC=$(CROSS)gcc clean; \
	fi
#	-rm -f Makefile config.log config.status
	-rm -f $(TI_filesystem_path)$(TI_sbindir)/dropbear*
	-rm -f $(TI_tools_path)/bin/dropbear*
	-rm -f $(TI_tools_path)$(TI_sbindir)/dropbear*
ifeq ($(CONFIG_TI_DROPBEAR_CLIENT),y) 
	-rm -f $(TI_filesystem_path)$(TI_sbindir)/dbclient
endif
ifeq ($(CONFIG_TI_DROPBEAR_SCP),y) 
	-rm -f $(TI_filesystem_path)$(TI_sbindir)/scp
endif

distclean:
#	-rm -f Makefile config.log config.status
	-rm -f $(TI_filesystem_path)$(TI_sbindir)/dropbear*
	-rm -f $(TI_tools_path)/bin/dropbear*
	-rm -f $(TI_tools_path)$(TI_sbindir)/dropbear*
ifeq ($(CONFIG_TI_DROPBEAR_CLIENT),y) 
	-rm -f $(TI_filesystem_path)$(TI_sbindir)/dbclient
endif
ifeq ($(CONFIG_TI_DROPBEAR_SCP),y) 
	-rm -f $(TI_filesystem_path)$(TI_sbindir)/scp
endif
