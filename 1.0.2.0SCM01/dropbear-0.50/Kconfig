config TI_DROPBEAR
	bool "SSH Server, Client and other utils"
    depends on TI_NETDK
	select PACKET
	default y
	help
		Enable or Disable Dropbear package.

if TI_DROPBEAR
config TI_DROPBEAR_SERVER
	bool "SSH Server"
	default y
	help
		Enable SSH Server in Dropbear

config TI_DROPBEAR_CLIENT
	bool "SSH Client"
	default n
	help
		Enable SSH Client in Dropbear

config TI_DROPBEAR_KEY
	bool "Dropbear Key Generator"
	default y
	help
		Enable Key generator tool in Dropbear. This utility is built for host machine.

config TI_DROPBEAR_KEYCONVERTER
	bool "Key Converter"
	default y
	help
		Enable Key converter tools (Openssh key --> dropbear key) in Dropbear. This utility is built for the host machine.

config TI_DROPBEAR_SCP
	bool "SCP tool"
	default n
	help
		Enable SCP program in Dropbear

endif

