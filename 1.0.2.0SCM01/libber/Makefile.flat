# Include this file that contains definitions.
-include $(TARGET_HOME)/TI_Build.make
-include $(TARGET_HOME)/.config

all: build install

build:
	$(MAKE) CROSS=$(CROSS) prefix=$(TI_filesystem_path) includedir=$(TARGET_HOME)/ti/include all

install:
	$(MAKE) CROSS=$(CROSS) prefix=$(TI_filesystem_path) includedir=$(TARGET_HOME)/ti/include builddir=$(TI_build_root) install
ifdef CONFIG_TI_INSTALL_BER_TEST_APPS
	cp tests/test_utils $(TI_filesystem_path)/usr/sbin 
	cp tests/test_encode $(TI_filesystem_path)/usr/sbin 
	cp tests/test_decode $(TI_filesystem_path)/usr/sbin 
endif

clean:
	$(MAKE) -C src clean  
	$(MAKE) -C tests clean  
