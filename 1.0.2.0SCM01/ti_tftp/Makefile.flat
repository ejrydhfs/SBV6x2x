# Include this file that contains definitions.
-include $(TARGET_HOME)/TI_Build.make
-include $(TARGET_HOME)/.config

ifeq ($(CONFIG_TI_TFTP_SAMPLE_PLUGIN),y) 
TI_TFTP_PLUGIN=1
export TI_TFTP_PLUGIN
endif

INSTALL=install

all: build install

build:
	$(MAKE) CC=$(CROSS)gcc -C tftp tftp

install: 
	$(INSTALL) -m 0755 tftp/tftp $(TI_filesystem_path)$(TI_rsbindir)/ti_tftp
	-$(INSTALL) -m 0644 tftp/TI_tftp.h $(TI_include)
ifdef TI_TFTP_PLUGIN
	-$(INSTALL) -m 0644 tftp/tftp_sample_plugin.so $(TI_filesystem_path)$(TI_rlibdir)/
endif

clean: 
	$(MAKE) -C tftp clean
	-rm -f $(TI_filesystem_path)$(TI_rsbindir)/tftp
	-rm -f $(TI_include)/TI_tftp.h
ifdef TI_TFTP_PLUGIN
	-rm -f $(TI_filesystem_path)$(TI_rlibdir)/tftp_sample_plugin.so
endif
