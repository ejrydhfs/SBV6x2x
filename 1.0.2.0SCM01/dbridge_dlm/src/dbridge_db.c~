int mot_DbridgeDb_AltGetDstMac(char* dev, unsigned char* mac_address)
{
    int index;
    
    for (index=0;index<alt_table_insert;index++)
    {
        if (memcmp((void *)dev, (void *)&dbridge_db.altTable[index].dbridgeDevice->ptr_interface->name, strlen(dev)) == 0)
