/* cqvds00011817 -S : Cannot access the cable modem's URL http://192.168.100.1 with auto configured addressing. -Prabhakar R */
int mot_dbridgeDb_IsCpeExisting(unsigned int dest_ip)
{
    int index;
    unsigned char cpe_num;

    for (index=0;index<alt_table_insert;index++)
    {
        cpe_num = dbridge_db.altTable[index].cpe_number;
        if ( (cpe_num <=DBR_MAX_CPE_ENTRY) && (cpe_num > 0) )
        {
/* it's a cpe */
            if (dest_ip == cpe_table.cpeTable[index].cpe_ip)
            {                
                return 1;
            }
        }
    }
    return 0;
}
