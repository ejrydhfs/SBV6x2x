int mot_DbridgeDb_SaveCpeMacIp(unsigned int cpe_cached_ip, unsigned char* cpe_mac)
{
    int index;
    unsigned char cpe_num;

    for (index=0;index<alt_table_insert;index++)
    {
        cpe_num = dbridge_db.altTable[index].cpe_number;
        if ( (cpe_num <=DBR_MAX_CPE_ENTRY) && (cpe_num > 0) )
        {
/* it's a cpe */
            if (memcmp((void *)cpe_mac, (void *)&dbridge_db.altTable[index].macAddress[0], MAC_ADDRESS_LEN) == 0)
            {
/* there is an entry in the ALT, save the IP and MAC in the CPE table */
                cpe_table.cpeTable[index].cpe_ip = cpe_cached_ip;
                cpe_table.cpeTable[index].cpe_number = dbridge_db.altTable[index].cpe_number;
                memcpy((void *)&cpe_table.cpeTable[index].macAddress[0], (void *)cpe_mac, MAC_ADDRESS_LEN);
                return 0;
            }
        }
    }
    return -1;
}    

int mot_DbridgeDb_IsDestCpe(unsigned int dest_ip, unsigned char* dest_mac)
{
    int index;
    unsigned char cpe_num;

    for (index=0;index<alt_table_insert;index++)
    {
        cpe_num = dbridge_db.altTable[index].cpe_number;
        if ( (cpe_num <=DBR_MAX_CPE_ENTRY) && (cpe_num > 0) )
        {
/* it's a cpe */
            if (dest_ip == cpe_table.cpeTable[index].cpe_ip)
            {
                memcpy((void *)dest_mac, (void *)&cpe_table.cpeTable[index].macAddress[0], MAC_ADDRESS_LEN);
                return 0;
            }
        }
    }
    return -1;
}  
