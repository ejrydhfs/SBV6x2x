 *  \param[in] no input.
 *  \param[out] no output.
 *  \return OK or error status.
 **************************************************************************/
int __init dbridgeCtl_init(void)
{

	/* create base directory for dbrctl */
	dbrctl = create_proc_entry("net/dbrctl", S_IFDIR, NULL);
	if (dbrctl)
	{
		dbrctl->read_proc  = NULL;
		dbrctl->write_proc = NULL;
	}

	/* create init proc */
	dbrctl_init = create_proc_entry("net/dbrctl/init", 0644,NULL);
