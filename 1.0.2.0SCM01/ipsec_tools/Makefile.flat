# Include this file that contains definitions.
-include $(TARGET_HOME)/TI_Build.make

all: build install

build:
	$(MAKE) CROSS_COMPILE=$(CROSS) LIBC_DIR=$(TARGET_HOME)/ti$(TI_rlibdir)/ all

install:
	install -m 0755 src/libipsec/libipsec.so $(TI_filesystem_path)$(TI_rlibdir)/.
	install -m 0755 src/setkey/setkey $(TI_filesystem_path)$(TI_sbindir)/setkey
	install -m 0644 src/libipsec/libpfkey.h $(TI_build_root)/ti/include 
	install -m 0644 src/include-glibc/net/pfkeyv2.h $(TI_build_root)/ti/include/net 
	install -m 0644 src/include-glibc/netinet/ipsec.h $(TI_build_root)/ti/include/netinet

clean:
	$(MAKE) clean

